# Convenience wrapper around the CMake build, which is the supported build
# system on current distributions. CMake picks up whatever wxWidgets (3.x) the
# distribution ships; nothing is generated by hand any more.
#
#   make                          configure + build into ./build
#   make -j8                      build with a fixed number of jobs
#   make install                  install under $(PREFIX) (default /usr/local)
#   sudo make install             system-wide install
#   make DESTDIR=/tmp/pkg install staged install (for packaging)
#   make clean                    remove ./build
#
# Variables: PREFIX, DESTDIR, BUILD_DIR, BUILD_TYPE, JOBS, CMAKE.

PREFIX ?= /usr/local
DESTDIR ?=
BUILD_DIR ?= build
BUILD_TYPE ?= Release
CMAKE ?= cmake
JOBS ?= $(shell nproc 2>/dev/null || echo 2)

VPATH = $(BUILD_DIR)
BIN = $(BUILD_DIR)/nabbitemu

.PHONY: all configure install uninstall clean distclean help

all: $(BIN)

configure:
	@$(CMAKE) -S . -B $(BUILD_DIR) \
		-DCMAKE_BUILD_TYPE=$(BUILD_TYPE) \
		-DCMAKE_INSTALL_PREFIX=$(PREFIX)

$(BIN): configure
	@$(CMAKE) --build $(BUILD_DIR) --parallel $(JOBS)

install: $(BIN)
	@echo "Installing nabbitemu to: $(DESTDIR)$(PREFIX)/bin"
	@DESTDIR="$(DESTDIR)" $(CMAKE) --install $(BUILD_DIR) --prefix $(PREFIX)

uninstall:
	@echo "Uninstalling nabbitemu from: $(DESTDIR)$(PREFIX)"
	rm -f "$(DESTDIR)$(PREFIX)/bin/nabbitemu"
	rm -f "$(DESTDIR)$(PREFIX)/share/applications/nabbitemu.desktop"
	rm -f "$(DESTDIR)$(PREFIX)/share/icons/hicolor/16x16/apps/nabbitemu.png"
	rm -rf "$(DESTDIR)$(PREFIX)/share/doc/nabbitemu"

clean:
	rm -rf "$(BUILD_DIR)"

# Kept for the old premake workflow's muscle memory.
distclean: clean

help:
	@echo "nabbitemu build targets:"
	@echo "   all        configure + build into $(BUILD_DIR) (default)"
	@echo "   install    install under \$$(PREFIX) (default $(PREFIX))"
	@echo "   uninstall  remove the installed files"
	@echo "   clean      delete $(BUILD_DIR)"
	@echo ""
	@echo "Variables: PREFIX=$(PREFIX) BUILD_DIR=$(BUILD_DIR) BUILD_TYPE=$(BUILD_TYPE) JOBS=$(JOBS)"
